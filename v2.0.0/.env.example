# Copy this to .env beside the script (NOT committed) and fill in real values:
#   cp .env.example .env && chmod 600 .env
#
# Find these in Supabase: Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service_role-key-here

# --- Optional -----------------------------------------------------------------
# Label for who ran it: appears as "source" in the JSONL log. Defaults to the
# machine hostname; a health monitor uses it to name the tile. On CI the Action
# sets this to "github-action".
# KEEPALIVE_SOURCE=my-pi

# Where the JSONL health log is written. Defaults to keepalive.log beside the
# script. A monitor reads only the LAST line (status + freshness).
# KEEPALIVE_LOG=/home/USER/supabase-keepalive/keepalive.log

# Retry tuning for transient network/DNS failures.
# KEEPALIVE_ATTEMPTS=3
# KEEPALIVE_DELAY=10

# Set by a dashboard's "check now" action to distinguish a forced check from a
# scheduled run in the log ("trigger":"manual"). Leave unset for cron ("cron").
# KEEPALIVE_TRIGGER=manual

# Point the script at an existing table instead of the dedicated `keepalive`
# one from setup.sql. The table needs an int `id` PK and a `last_run` timestamptz.
# KEEPALIVE_TABLE=keepalive
# KEEPALIVE_ID=1
